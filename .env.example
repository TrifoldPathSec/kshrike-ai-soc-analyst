# Copy to .env and fill in. Never commit .env.

# --- Claude -------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper investigation, more tokens)
CLAUDE_EFFORT=medium

# --- Wazuh indexer (defaults from wazuh-docker single-node) -------------
INDEXER_USER=admin
INDEXER_PASSWORD=SecretPassword

# --- Triage policy ------------------------------------------------------
# Only alerts at or above this Wazuh rule level get triaged (0-15).
MIN_RULE_LEVEL=7
POLL_INTERVAL_SECONDS=30
# Alerts with the same agent + rule + source IP inside this window are
# grouped into one case instead of being triaged one by one.
GROUP_WINDOW_MINUTES=15
# Hard cap on Claude triages per hour, to keep API spend predictable.
MAX_TRIAGES_PER_HOUR=20

# --- Optional enrichment (leave blank to skip) --------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Optional notifications (Slack or Discord incoming webhook URL) -----
NOTIFY_WEBHOOK_URL=
# Only notify for these severities (comma-separated).
NOTIFY_SEVERITIES=critical,high

# Agent package version for the victim; keep it <= the Wazuh manager version.
WAZUH_AGENT_VERSION=4.14.9-1
